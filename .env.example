# Mapbox configuration for rendering the interactive 3D park map
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1...your_token_here..."

# Upstash Redis configuration for storing historical wait time data and telemetry
KV_REST_API_URL="https://...upstash.io"
KV_REST_API_TOKEN="...your_token_here..."

# Secret used to authenticate the automated data ingestion pipeline (/api/cron/save)
# Make sure to configure your cron service to pass this as a Bearer token:
# Authorization: Bearer <your_secret_here>
CRON_SECRET="your_secure_random_string_here"
